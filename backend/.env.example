# DO Record CMS Environment Variables Example

PROJECT_NAME="DO Record Media CMS"
SECRET_KEY="replace_with_secure_random_64_character_string"

# MongoDB Database Configuration
MONGO_URL=mongodb://localhost:27017/cms_db
DATABASE_NAME="dorecord_cms_db"
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
VERIFY_DATABASE_ON_STARTUP=true

# Admin Seed Defaults
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@dorecord.com"
ADMIN_PASSWORD="replace_with_secure_admin_password"

# Optional Cache Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379

